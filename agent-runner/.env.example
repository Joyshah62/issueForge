# ── LLM provider ─────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint.
# Groq (fast, free tier):    https://api.groq.com/openai/v1
# Together AI (best coder):  https://api.together.xyz/v1
# Fireworks AI:              https://api.fireworks.ai/inference/v1
# Ollama (local):            http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
# Model to use for coding-agent steps.
# Groq:       llama-3.3-70b-versatile   (fast, free)
# Together:   Qwen/Qwen3-Coder-480B-A35B-Instruct (best coding quality)
# Ollama:     qwen2.5-coder:32b
LLM_MODEL=llama-3.3-70b-versatile

# ── GitHub ────────────────────────────────────────────────────────────────────
# PAT with: repo, pull_requests:write, issues:write
GITHUB_TOKEN=ghp_your_token_here

# ── Render (optional — for preview deployments) ───────────────────────────────
RENDER_API_KEY=rnd_your_key_here
RENDER_SERVICE_ID=srv_your_service_id_here

# ── Agent runner ──────────────────────────────────────────────────────────────
# Bearer token callers must send in Authorization header.
# Set to any random string; paste the same value into canvas.yaml.
AGENT_RUNNER_KEY=change_me_to_a_random_secret

PORT=3001
